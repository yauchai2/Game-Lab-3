config_version=5

[application]

config/name="Afterhours — Neon Facets Lab"
boot_splash/image="res://assets/ui/ink/logo-source.png"
boot_splash/bg_color=Color(0,0,0,1)
run/main_scene="res://scenes/combat/street_fight.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="fractional"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.14, 0.17, 0.21, 1)

[shader_globals]

ink_fx_focus={
"type": "float",
"value": 0.0
}
ink_fx_focus_at={
"type": "vec3",
"value": Vector3(0, 1, 3)
}
